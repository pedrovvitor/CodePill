# CodePill local dev stack — copy to .env to override defaults.
# These are LOCAL-ONLY defaults; real environments get secrets from the
# secret manager (SECURITY.md §4.4 — never commit real credentials).

# bootstrap superuser (admin/init only — services never use it)
POSTGRES_USER=codepill
POSTGRES_PASSWORD=codepill-local

# per-service database roles (created by ops/db/init/01-create-databases.sql;
# changing a password here requires ALTER ROLE on an existing volume)
IDENTITY_DB_USER=codepill_identity_svc
IDENTITY_DB_PASSWORD=codepill-local
CATALOG_DB_USER=codepill_catalog_svc
CATALOG_DB_PASSWORD=codepill-local
KEYCLOAK_DB_USER=keycloak_svc
KEYCLOAK_DB_PASSWORD=codepill-local

REDIS_PASSWORD=codepill-local

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
