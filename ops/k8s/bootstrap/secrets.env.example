# Copy to secrets.env on the VPS (chmod 600, NEVER commit) and run bootstrap.sh.
# Generate strong values: openssl rand -base64 24

POSTGRES_PASSWORD=
CATALOG_DB_PASSWORD=
IDENTITY_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
REDIS_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Only while the GHCR packages are private (a GitHub PAT with read:packages).
# Leave empty once the images are public.
GHCR_USERNAME=
GHCR_TOKEN=
