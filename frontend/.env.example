# CodePill SPA — local dev defaults (no secrets; SPA config is public by nature).
# Copy to .env to override. Values shown are the in-code defaults.

# Same-origin in dev (Vite proxies /api -> http://localhost:8080). Set to an
# absolute origin only when the API is NOT proxied/same-origin.
VITE_API_BASE_URL=

VITE_OIDC_AUTHORITY=http://localhost:8180/realms/codepill
VITE_OIDC_CLIENT_ID=codepill-web

# OTel collector OTLP/HTTP traces endpoint (CORS-allowlisted for :5173).
VITE_OTLP_TRACES_URL=http://localhost:4318/v1/traces
VITE_DEPLOYMENT_ENV=local

# Fraction of traces sampled at the root, 0..1 (child spans follow their
# parent's decision). Keep 1.0 locally; lower in high-traffic environments.
VITE_TRACE_SAMPLING=1.0
